{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/tile-formatting.schema.json",
  "height": 300,
  "width": 320,
  "hideSelection": false,
  "fillHorizontally": true,
  "formatter": {
    "elmType": "div",
    "customRowAction": {
      "action": "defaultClick"
    },
    "style": {
      "display": "flex",
      "flex-direction": "column",
      "box-sizing": "border-box",
      "height": "288px",
      "margin": "6px",
      "padding": "14px 16px",
      "border-radius": "6px",
      "background-color": "#ffffff",
      "box-shadow": "0 1.6px 3.6px rgba(0,0,0,.13), 0 0.3px 0.9px rgba(0,0,0,.11)",
      "border-left": "='6px solid ' + if([$pmRAG] == 'Зелений', '#2e7d32', if([$pmRAG] == 'Жовтий', '#f2a900', if([$pmRAG] == 'Червоний', '#c62828', '#bdbdbd')))",
      "cursor": "pointer",
      "overflow": "hidden"
    },
    "children": [
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "justify-content": "space-between",
          "align-items": "center",
          "font-size": "12px",
          "color": "#605e5c"
        },
        "children": [
          {
            "elmType": "span",
            "txtContent": "[$pmCode]"
          },
          {
            "elmType": "svg",
            "attributes": {
              "viewBox": "0 0 24 24",
              "title": "[$pmType]"
            },
            "style": {
              "width": "18px",
              "height": "18px",
              "display": "=if([$pmType] == 'Стратегічний', 'inline', 'none')"
            },
            "children": [
              {
                "elmType": "path",
                "attributes": {
                  "d": "M12 2 4 5v6.2c0 4.9 3.4 9.3 8 10.8 4.6-1.5 8-5.9 8-10.8V5z"
                },
                "style": {
                  "fill": "#8e44c9"
                }
              },
              {
                "elmType": "path",
                "attributes": {
                  "d": "M12 4.6l.9 1.3v7.2h2.3v1.4h-2.3v2h.5v1.2h-2.8v-1.2h.5v-2H8.8v-1.4h2.3V5.9z"
                },
                "style": {
                  "fill": "#ffffff"
                }
              }
            ]
          }
        ]
      },
      {
        "elmType": "div",
        "txtContent": "[$Title]",
        "style": {
          "font-size": "16px",
          "font-weight": "600",
          "margin": "6px 0 4px",
          "line-height": "1.3",
          "max-height": "42px",
          "overflow": "hidden"
        }
      },
      {
        "elmType": "div",
        "txtContent": "[$pmStatus]",
        "style": {
          "font-size": "12px",
          "color": "#605e5c",
          "margin-bottom": "10px"
        }
      },
      {
        "elmType": "div",
        "style": {
          "width": "100%",
          "height": "16px",
          "background-color": "#edebe9",
          "border-radius": "8px",
          "position": "relative",
          "overflow": "hidden",
          "flex-shrink": "0"
        },
        "children": [
          {
            "elmType": "div",
            "style": {
              "height": "100%",
              "width": "=if([$pmProgress] > 100, '100%', [$pmProgress] + '%')",
              "background-color": "=if([$pmProgress] >= 100, '#2e7d32', '#0078d4')"
            }
          },
          {
            "elmType": "span",
            "txtContent": "=[$pmProgress] + '%'",
            "style": {
              "position": "absolute",
              "left": "0",
              "right": "0",
              "top": "0",
              "text-align": "center",
              "font-size": "11px",
              "line-height": "16px",
              "font-weight": "600",
              "color": "#323130"
            }
          }
        ]
      },
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "align-items": "center",
          "margin-top": "12px",
          "font-size": "12px",
          "color": "#605e5c"
        },
        "children": [
          {
            "elmType": "span",
            "style": {
              "width": "8px",
              "height": "8px",
              "border-radius": "50%",
              "margin-right": "6px",
              "background-color": "=if(Number([$pmLastUpdate]) == 0, '#bdbdbd', if(Number(@now) - Number([$pmLastUpdate]) > 1209600000, '#c62828', if(Number(@now) - Number([$pmLastUpdate]) > 691200000, '#f2a900', '#2e7d32')))"
            }
          },
          {
            "elmType": "span",
            "txtContent": "=if(Number([$pmLastUpdate]) == 0, '—', toLocaleDateString([$pmLastUpdate]))"
          }
        ]
      },
      {
        "elmType": "div",
        "txtContent": "[$pmLastReport]",
        "style": {
          "font-size": "13px",
          "margin-top": "4px",
          "line-height": "1.4",
          "max-height": "74px",
          "overflow": "hidden",
          "flex-grow": "1"
        }
      },
      {
        "elmType": "div",
        "style": {
          "display": "flex",
          "justify-content": "space-between",
          "align-items": "center",
          "margin-top": "auto",
          "padding-top": "8px"
        },
        "children": [
          {
            "elmType": "a",
            "txtContent": "Loop ↗",
            "attributes": {
              "href": "[$pmLoop]",
              "target": "_blank"
            },
            "style": {
              "display": "=if([$pmLoop] == '', 'none', 'inline')",
              "font-size": "13px",
              "font-weight": "600",
              "color": "#0078d4",
              "text-decoration": "none"
            }
          },
          {
            "elmType": "div",
            "style": {
              "display": "flex",
              "align-items": "center",
              "margin-left": "auto"
            },
            "attributes": {
              "title": "=[$pmManager.title] + ' · ' + [$pmManager.email]"
            },
            "children": [
              {
                "elmType": "img",
                "attributes": {
                  "src": "='/_layouts/15/userphoto.aspx?size=S&accountname=' + [$pmManager.email]"
                },
                "style": {
                  "width": "24px",
                  "height": "24px",
                  "border-radius": "50%",
                  "margin-right": "8px",
                  "object-fit": "cover"
                }
              },
              {
                "elmType": "span",
                "txtContent": "[$pmManager.title]",
                "style": {
                  "font-size": "13px",
                  "font-weight": "600",
                  "white-space": "nowrap",
                  "overflow": "hidden",
                  "text-overflow": "ellipsis",
                  "max-width": "160px"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}